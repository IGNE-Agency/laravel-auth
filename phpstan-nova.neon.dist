# The default analysis plus src/Nova, for the CI job that installs Nova.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests/Fixtures
    databaseMigrationsPath:
        - tests/database/migrations
        - vendor/laravel/sanctum/database/migrations
    stubFiles:
        - phpstan/scramble.stub
