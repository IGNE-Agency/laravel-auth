    "components": {
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "description": "An access token from POST /auth/login in token mode.",
                "scheme": "bearer"
            },
            "session": {
                "type": "apiKey",
                "description": "The session cookie of an SPA that logged in in session mode.",
                "in": "cookie",
                "name": "laravel_session"
            },
            "xsrf": {
                "type": "apiKey",
                "description": "The value of the XSRF-TOKEN cookie, required with the session cookie.",
                "in": "header",
                "name": "X-XSRF-TOKEN"
            }
        },
        "schemas": {
            "Authenticatable": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "integer",
                            "string"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "confirmation_method": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "How the user confirms their identity on POST /user/confirm-password: with their password, with a code from their authenticator app, or with an emailed code from POST /user/confirm-password/code. Null when they can't.",
                        "enum": [
                            "password",
                            "totp",
                            "login_code",
                            null
                        ]
                    },
                    "two_factor_enabled": {
                        "type": "boolean",
                        "description": "Whether the user set up two-factor authentication."
                    },
                    "two_factor_required": {
                        "type": "boolean",
                        "description": "Whether the user must set up two-factor authentication before they can use the app."
                    }
                },
                "required": [
                    "id",
                    "email",
                    "confirmation_method",
                    "two_factor_enabled",
                    "two_factor_required"
                ],
                "title": "Authenticatable"
            }
        },
        "responses": {
            "ValidationError": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "The messages per invalid field.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "Too many attempts",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "Unauthenticated": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "PasswordConfirmationRequired": {
                "description": "Password confirmation required: confirm the password, then retry.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}