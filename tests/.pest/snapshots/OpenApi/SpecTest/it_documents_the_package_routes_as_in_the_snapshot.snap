    },
    "components": {
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "description": "An access token from POST /auth/login in token mode.",
                "x-auth-mode": "token",
                "scheme": "bearer"
            },
            "session": {
                "type": "apiKey",
                "description": "The session cookie of an SPA that logged in in session mode.",
                "x-auth-mode": "session",
                "in": "cookie",
                "name": "laravel_session"
            },
            "xsrf": {
                "type": "apiKey",
                "description": "The value of the XSRF-TOKEN cookie, required with the session cookie.",
                "x-auth-mode": "session",
                "in": "header",
                "name": "X-XSRF-TOKEN"
            }
        },
        "schemas": {
            "ActiveSession": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "\"session:\" plus the SHA-256 hash of the session id, or \"token:\" plus the access token id; for DELETE /user/sessions/{session}."
                    },
                    "type": {
                        "type": "string",
                        "description": "\"session\" for a cookie session, \"token\" for an access token.",
                        "enum": [
                            "session",
                            "token"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "The user agent of a session, or the name of an access token."
                    },
                    "ip_address": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The last IP address of a session; null for an access token."
                    },
                    "last_active_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "is_current": {
                        "type": "boolean",
                        "description": "Whether the request comes from this session or access token."
                    }
                },
                "required": [
                    "id",
                    "type",
                    "name",
                    "ip_address",
                    "last_active_at",
                    "is_current"
                ],
                "title": "ActiveSession"
            },
            "Authenticatable": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "integer",
                            "string"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "confirmation_method": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "How the user confirms their identity on POST /user/confirm-password: with their password, with a code from their authenticator app, or with an emailed code from POST /user/confirm-password/code. Null when they can't.",
                        "enum": [
                            "password",
                            "totp",
                            "login_code",
                            null
                        ]
                    },
                    "two_factor_enabled": {
                        "type": "boolean",
                        "description": "Whether the user set up two-factor authentication."
                    },
                    "two_factor_required": {
                        "type": "boolean",
                        "description": "Whether the user must set up two-factor authentication before they can use the app."
                    }
                },
                "required": [
                    "id",
                    "email",
                    "confirmation_method",
                    "two_factor_enabled",
                    "two_factor_required"
                ],
                "title": "Authenticatable"
            },
            "TrustedDevice": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The device id for DELETE /user/devices/{trustedDevice}."
                    },
                    "name": {
                        "type": "string",
                        "description": "The \"device_name\" given at login, or the user agent."
                    },
                    "ip_address": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The IP address the device passed the two-factor challenge from."
                    },
                    "remembered": {
                        "type": "boolean",
                        "description": "Whether the user asked to remember the device (\"remember_device\")."
                    },
                    "last_used_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "When the trust ends; null when it ends with the access token."
                    },
                    "is_current": {
                        "type": "boolean",
                        "description": "Whether the request comes from this device."
                    }
                },
                "required": [
                    "id",
                    "name",
                    "ip_address",
                    "remembered",
                    "last_used_at",
                    "expires_at",
                    "is_current"
                ],
                "title": "TrustedDevice"
            }
        },
        "responses": {
            "ValidationError": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "The messages per invalid field.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "Too many attempts",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "Unauthenticated": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "PasswordConfirmationRequired": {
                "description": "Password confirmation required: confirm the password, then retry.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}