{
    "paths": {
        "/auth/forgot-password": {
            "post": {
                "operationId": "authentication.password.email",
                "description": "Always answers with the same success for a valid email address, whether or not an account exists. Only users that can log in with a password get a link.",
                "summary": "Request a password reset link",
                "tags": [
                    "Authentication"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The request was accepted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "operationId": "authentication.login",
                "description": "Session mode (an SPA whose requests run through Sanctum's stateful stack) logs in to the cookie session. Token mode answers with an access token instead; \"remember\" is ignored and \"device_name\" names the token (the user agent otherwise). \"password\" is the user's password, or a login code from POST /auth/login-code for users that log in with codes.",
                "summary": "Log in with email and password or login code",
                "tags": [
                    "Authentication"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "remember": {
                                        "type": "boolean"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "two_factor": {
                                            "type": "boolean",
                                            "description": "Whether a two-factor challenge must follow."
                                        },
                                        "token": {
                                            "type": "string",
                                            "description": "Token mode only: the access token for the Authorization: Bearer header."
                                        },
                                        "expires_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "format": "date-time",
                                            "description": "Token mode only: when the access token expires, or null when it does not."
                                        }
                                    },
                                    "required": [
                                        "two_factor"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
        "/auth/login-code": {
            "post": {
                "operationId": "authentication.login-code",
                "description": "Emails a one-time login code when the account can log in with one. The answer is always 202 with the same body: for unknown accounts, for accounts that can't use codes and when rate-limited too, so it never reveals whether an account exists. Log in by sending the code as \"password\" to POST /auth/login.",
                "summary": "Request a login code",
                "tags": [
                    "Authentication"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "The request was accepted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "authentication.logout",
                "description": "Session mode ends the session. Token mode revokes the access token the request was sent with.",
                "summary": "Log out",
                "tags": [
                    "Authentication"
                ],
                "responses": {
                    "204": {
                        "description": "Logged out"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    },
                    {
                        "session": [],
                        "xsrf": []
                    }
                ]
            }
        },
        "/auth/reset-password": {
            "post": {
                "operationId": "authentication.password.update",
                "summary": "Reset the password with a reset token",
                "tags": [
                    "Authentication"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "token": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "password_confirmation": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "token",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The password was reset",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/user": {
            "get": {
                "operationId": "authentication.user",
                "summary": "Get the authenticated user",
                "tags": [
                    "Authentication"
                ],
                "responses": {
                    "200": {
                        "description": "The authenticated user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Authenticatable"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    },
                    {
                        "session": [],
                        "xsrf": []
                    }
                ]
            }
        },
        "/user/confirm-password": {
            "post": {
                "operationId": "authentication.password.confirm.store",
                "description": "Starts the password confirmation window that routes requiring a recent confirmation (423) check. Token mode keeps it per access token. \"password\" is what the user's \"confirmation_method\" says: their password, or an emailed code from POST /user/confirm-password/code.",
                "summary": "Confirm the password",
                "tags": [
                    "Authentication"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The password was confirmed"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    },
                    {
                        "session": [],
                        "xsrf": []
                    }
                ]
            }
        },
        "/user/confirm-password/code": {
            "post": {
                "operationId": "authentication.password.confirm.code",
                "description": "Emails a one-time code to a user whose \"confirmation_method\" is \"login_code\". Confirm by sending it as \"password\" to POST /user/confirm-password.",
                "summary": "Request a confirmation code",
                "tags": [
                    "Authentication"
                ],
                "responses": {
                    "202": {
                        "description": "The code was sent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The user confirms with another method",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "code": {
                                            "type": "string",
                                            "enum": [
                                                "login_code_unavailable"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message",
                                        "code"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    },
                    {
                        "session": [],
                        "xsrf": []
                    }
                ]
            }
        },
        "/user/confirmed-password-status": {
            "get": {
                "operationId": "authentication.password.confirmation",
                "summary": "Get the password confirmation status",
                "tags": [
                    "Authentication"
                ],
                "parameters": [
                    {
                        "name": "seconds",
                        "in": "query",
                        "description": "The confirmation window in seconds. Defaults to the app's password timeout.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Whether the password was confirmed recently",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "confirmed": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "confirmed"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    },
                    {
                        "session": [],
                        "xsrf": []
                    }
                ]
            }
        },
        "/user/password": {
            "put": {
                "operationId": "authentication.user-password.update",
                "description": "Only for users that log in with a password.",
                "summary": "Change the password",
                "tags": [
                    "Authentication"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "current_password": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "password_confirmation": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "current_password",
                                    "password",
                                    "password_confirmation"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The password was changed"
                    },
                    "403": {
                        "description": "The user does not log in with a password",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "code": {
                                            "type": "string",
                                            "enum": [
                                                "password_unavailable"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message",
                                        "code"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                },
                "security": [
                    {
                        "bearer": []
                    },
                    {
                        "session": [],
                        "xsrf": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "description": "An access token from POST /auth/login in token mode.",
                "scheme": "bearer"
            },
            "session": {
                "type": "apiKey",
                "description": "The session cookie of an SPA that logged in in session mode.",
                "in": "cookie",
                "name": "laravel_session"
            },
            "xsrf": {
                "type": "apiKey",
                "description": "The value of the XSRF-TOKEN cookie, required with the session cookie.",
                "in": "header",
                "name": "X-XSRF-TOKEN"
            }
        },
        "schemas": {
            "Authenticatable": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "integer",
                            "string"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "confirmation_method": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "How the user confirms their identity on POST /user/confirm-password: with their password, or with an emailed code from POST /user/confirm-password/code. Null when they can't.",
                        "enum": [
                            "password",
                            "login_code",
                            null
                        ]
                    }
                },
                "required": [
                    "id",
                    "email",
                    "confirmation_method"
                ],
                "title": "Authenticatable"
            }
        },
        "responses": {
            "ValidationError": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "The messages per invalid field.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "Too many attempts",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "Unauthenticated": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}