                                    "required": [
                                        "secretKey"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Two-factor authentication is not set up",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
