includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests/Fixtures
    excludePaths:
        - src/Nova
        - tests/Fixtures/Nova
    databaseMigrationsPath:
        - tests/database/migrations
        - vendor/laravel/sanctum/database/migrations
    stubFiles:
        - phpstan/scramble.stub
