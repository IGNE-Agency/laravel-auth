{
    "name": "igne-agency/laravel-auth",
    "description": "Headless authentication for Laravel apps on top of Laravel Fortify and Sanctum: one login flow for SPA cookie and bearer-token clients.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "authentication",
        "fortify",
        "sanctum"
    ],
    "authors": [
        {
            "name": "Rick Blanksma",
            "email": "rick@igne.nl"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/session": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "laravel/fortify": "^1.42",
        "laravel/sanctum": "^4.4"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.48",
        "igne-agency/laravel-problem-details": "*",
        "igne-agency/laravel-scramble-extensions": "*",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.20",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "suggest": {
        "laravel/nova": "Adds the Nova adapter for the authentication flows."
    },
    "autoload": {
        "psr-4": {
            "Igne\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Igne\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Igne\\Auth\\AuthenticationServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../laravel-error-contract",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../laravel-api-docs",
            "options": {
                "symlink": true
            }
        }
    ]
}
